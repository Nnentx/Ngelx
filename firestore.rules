rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function chatMember() { return signedIn() && request.auth.uid in resource.data.members; }
    function formerChatMember() { return signedIn() && request.auth.uid in resource.data.get('formerMembers', []); }
    function chatViewer() { return chatMember() || formerChatMember(); }
    function incomingChatMember() { return signedIn() && request.auth.uid in request.resource.data.members; }
    function chatAdmin() {
      return signedIn() && request.auth.uid in resource.data.get('admins', []);
    }
    function groupMetadataUnchanged() {
      return request.resource.data.get('groupName', '') == resource.data.get('groupName', '')
        && request.resource.data.get('groupPhotoUrl', '') == resource.data.get('groupPhotoUrl', '')
        && request.resource.data.get('admins', []) == resource.data.get('admins', [])
        && request.resource.data.get('moderators', []) == resource.data.get('moderators', [])
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && request.resource.data.get('onlyAdminsCanPost', false) == resource.data.get('onlyAdminsCanPost', false)
        && request.resource.data.get('onlyAdminsCanAddMembers', false) == resource.data.get('onlyAdminsCanAddMembers', false)
        && request.resource.data.get('onlyAdminsCanEditGroup', true) == resource.data.get('onlyAdminsCanEditGroup', true)
        && request.resource.data.get('onlyAdminsCanPin', true) == resource.data.get('onlyAdminsCanPin', true)
        && request.resource.data.get('onlyAdminsCanMentionAll', false) == resource.data.get('onlyAdminsCanMentionAll', false)
        && request.resource.data.get('newMembersSeeHistory', true) == resource.data.get('newMembersSeeHistory', true)
        && request.resource.data.get('joinApproval', false) == resource.data.get('joinApproval', false)
        && request.resource.data.get('groupDescription', '') == resource.data.get('groupDescription', '')
        && request.resource.data.get('inviteCode', '') == resource.data.get('inviteCode', '')
        && request.resource.data.get('inviteUpdatedAt', null) == resource.data.get('inviteUpdatedAt', null)
        && request.resource.data.get('groupDeleted', false) == resource.data.get('groupDeleted', false);
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function founderProtected() {
      let founder = resource.data.get('createdBy', '');
      return resource.data.get('isGroup', false) != true
        || founder == ''
        || (
          request.resource.data.get('createdBy', '') == founder
          && founder in request.resource.data.get('members', [])
          && founder in request.resource.data.get('admins', [])
        );
    }
    function validFounderTransfer() {
      let oldFounder = resource.data.get('createdBy', '');
      let newFounder = request.resource.data.get('createdBy', '');
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && oldFounder != ''
        && request.auth.uid == oldFounder
        && newFounder != ''
        && newFounder != oldFounder
        && newFounder in resource.data.get('members', [])
        && newFounder in request.resource.data.get('members', [])
        && request.resource.data.get('admins', []).hasAll(resource.data.get('admins', []))
        && newFounder in request.resource.data.get('admins', [])
        && onlyChanges(['createdBy', 'admins', 'updatedAt']);
    }
    function validFormerHide() {
      return formerChatMember()
        && request.resource.data.members == resource.data.members
        && request.auth.uid in request.resource.data.get('hiddenFor', [])
        && onlyChanges(['hiddenFor']);
    }
    function validFounderClose() {
      let founder = resource.data.get('createdBy', '');
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && founder != ''
        && request.auth.uid == founder
        && resource.data.get('members', []).size() == 1
        && founder in resource.data.get('members', [])
        && request.resource.data.get('members', []).size() == 0
        && request.resource.data.get('admins', []).size() == 0
        && request.resource.data.get('createdBy', '') == founder
        && request.resource.data.get('groupDeleted', false) == true
        && onlyChanges(['members', 'admins', 'groupDeleted', 'deletedAt']);
    }
    function privateChatCreateAllowed() {
      let otherUid = request.resource.data.members[0] == request.auth.uid
        ? request.resource.data.members[1]
        : request.resource.data.members[0];
      let target = get(/databases/$(database)/documents/users/$(otherUid));
      let permission = target.data.get(
        'messagePermission',
        target.data.get('friendsOnlyMessages', true) ? 'friends' : 'all'
      );
      return request.resource.data.members.size() == 2
        && otherUid != request.auth.uid
        && (
          permission == 'all'
          || (
            permission == 'friends'
            && request.auth.uid in target.data.get('friends', [])
          )
          || (
            permission == 'following'
            && request.auth.uid in target.data.get('following', [])
          )
        );
    }
    function groupDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }
    function isGroupAdmin(chatId) {
      return signedIn() && request.auth.uid in groupDoc(chatId).data.get('admins', []);
    }
    function validInvite(code, chatId) {
      return code is string
        && code.size() > 0
        && exists(/databases/$(database)/documents/group_invites/$(code))
        && get(/databases/$(database)/documents/group_invites/$(code)).data.get('chatId', '') == chatId
        && groupDoc(chatId).data.get('inviteCode', '') == code
        && groupDoc(chatId).data.get('groupDeleted', false) != true;
    }
    function validPublicSelfJoin() {
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && resource.data.get('discoverable', false) == true
        && resource.data.get('joinApproval', false) != true
        && !(request.auth.uid in resource.data.get('members', []))
        && resource.data.get('members', []).size() < resource.data.get('maxMembers', 60)
        && request.resource.data.get('members', []) == resource.data.get('members', []).concat([request.auth.uid])
        && request.resource.data.get('formerMembers', []) == resource.data.get('formerMembers', []).removeAll([request.auth.uid])
        && request.resource.data.get('hiddenFor', []) == resource.data.get('hiddenFor', []).removeAll([request.auth.uid])
        && onlyChanges(['members', 'formerMembers', 'hiddenFor', 'updatedAt']);
    }
    function validSelfJoin(chatId) {
      let joinReq = get(/databases/$(database)/documents/chats/$(chatId)/joinRequests/$(request.auth.uid));
      let code = joinReq.data.get('inviteCode', '');
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && resource.data.get('joinApproval', false) != true
        && request.resource.data.members.size() <= 60
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.get('formerMembers', []) == resource.data.get('formerMembers', []).removeAll([request.auth.uid])
        && onlyChanges(['members', 'formerMembers', 'hiddenFor', 'updatedAt'])
        && joinReq.data.get('uid', '') == request.auth.uid
        && joinReq.data.get('status', '') == 'autojoin'
        && validInvite(code, chatId);
    }
    function validMemberAddition() {
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && request.auth.uid in resource.data.members
        && (
          request.auth.uid in resource.data.get('admins', [])
          || resource.data.get('onlyAdminsCanAddMembers', false) != true
        )
        && request.resource.data.members.size() > resource.data.members.size()
        && request.resource.data.members.size() <= 60
        && request.resource.data.members.hasAll(resource.data.members)
        && onlyChanges(['members', 'formerMembers', 'hiddenFor', 'updatedAt']);
    }
    function validMemberGroupEdit() {
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && request.auth.uid in resource.data.members
        && resource.data.get('onlyAdminsCanEditGroup', true) != true
        && onlyChanges(['groupName', 'groupPhotoUrl', 'groupDescription', 'updatedAt']);
    }
    function relationshipUpdate() {
      return signedIn()
        && onlyChanges(['followers', 'following', 'friends'])
        && (
          request.resource.data.get('followers', []) == resource.data.get('followers', [])
          || request.auth.uid in request.resource.data.get('followers', [])
          || request.auth.uid in resource.data.get('followers', [])
        )
        && (
          request.resource.data.get('following', []) == resource.data.get('following', [])
          || request.auth.uid in request.resource.data.get('following', [])
          || request.auth.uid in resource.data.get('following', [])
        )
        && (
          request.resource.data.get('friends', []) == resource.data.get('friends', [])
          || request.auth.uid in request.resource.data.get('friends', [])
          || request.auth.uid in resource.data.get('friends', [])
        );
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, delete: if isMe(uid);
      allow update: if isMe(uid) || relationshipUpdate();
      match /saved/{contentId} { allow read, write: if isMe(uid); }
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || onlyChanges(['shareCount', 'viewCount', 'captionsEnabled'])
        || onlyChanges(['likeCount'])
        || onlyChanges(['commentCount'])
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /likes/{uid} {
        allow read: if true;
        allow create, update, delete: if isMe(uid);
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if signedIn() && (
          resource.data.userId == request.auth.uid
          || onlyChanges(['likeCount'])
          || onlyChanges(['reactions'])
        );
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/videos/$(videoId)).data.ownerId == request.auth.uid
        );
        match /likes/{uid} {
          allow read: if true;
          allow create, update, delete: if isMe(uid);
        }
      }
    }

    match /chats/{chatId} {
      allow create: if incomingChatMember()
        && (
          (
            request.resource.data.get('isGroup', false) != true
            && privateChatCreateAllowed()
          )
          || (
            request.resource.data.get('isGroup', false) == true
            && request.resource.data.members.size() <= 60
            && request.auth.uid in request.resource.data.get('admins', [])
          )
        );
      allow read: if chatViewer() || (
        signedIn()
        && resource.data.get('isGroup', false) == true
        && resource.data.get('discoverable', false) == true
      );
      allow update: if (
        chatMember() && (
          (
            resource.data.get('isGroup', false) != true
            && request.resource.data.members == resource.data.members
          )
          || (chatAdmin() && request.resource.data.members.size() <= 60 && founderProtected())
          || validFounderTransfer()
          || validMemberAddition()
          || validMemberGroupEdit()
          || (
            groupMetadataUnchanged()
            && (
              request.resource.data.members == resource.data.members
              || request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            )
          )
        )
      ) || validSelfJoin(chatId) || validPublicSelfJoin() || validFormerHide() || validFounderClose();
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          || (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('formerMembers', [])
            && get(/databases/$(database)/documents/chats/$(chatId)).data.get('removedAt_' + request.auth.uid, null) != null
            && resource.data.get('createdAt', get(/databases/$(database)/documents/chats/$(chatId)).data.get('removedAt_' + request.auth.uid, null)) <= get(/databases/$(database)/documents/chats/$(chatId)).data.get('removedAt_' + request.auth.uid, null)
          )
        );
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.get('type', 'text') != 'poll'
          && (
            (
              request.resource.data.senderId == request.auth.uid
              && (
                get(/databases/$(database)/documents/chats/$(chatId)).data.get('onlyAdminsCanPost', false) != true
                || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('admins', [])
                || (
                  request.resource.data.get('type', '') == 'system'
                  && request.resource.data.get('actorUid', '') == request.auth.uid
                  && request.resource.data.get('systemAction', '') in [
                    'member_added',
                    'member_joined',
                    'member_left',
                    'call_join',
                    'call_leave',
                    'call_end'
                  ]
                )
              )
            )
            || (
              request.resource.data.senderId == 'system'
              && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('admins', [])
            )
          );
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && (
            (
              resource.data.senderId == request.auth.uid
              && onlyChanges(['text', 'editedAt'])
            )
            || (
              resource.data.senderId == request.auth.uid
              && onlyChanges(['callStatus', 'callAnsweredAt', 'callConnectedAt', 'callEndedAt', 'durationSeconds'])
            )
            || onlyChanges(['reactions'])
            || (
              get(/databases/$(database)/documents/chats/$(chatId)).data.get('isGroup', false) != true
              && onlyChanges(['pinned', 'pinnedAt', 'pinnedBy'])
            )
            || (
              (
                request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('admins', [])
                || get(/databases/$(database)/documents/chats/$(chatId)).data.get('onlyAdminsCanPin', true) != true
              )
              && onlyChanges(['pinned', 'pinnedAt', 'pinnedBy'])
            )
            || (
              (resource.data.senderId == request.auth.uid
                || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('admins', []))
              && request.resource.data.get('deletedForEveryone', false) == true
              && onlyChanges([
                'deletedForEveryone', 'deletedAt', 'deletedBy',
                'text', 'mediaUrl', 'audioUrl', 'fileUrl', 'fileName',
                'reactions', 'pinned', 'pinnedAt', 'pinnedBy'
              ])
            )
          );
        allow delete: if signedIn() && (
          resource.data.senderId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('admins', [])
        );
      }

      match /joinRequests/{requestUid} {
        allow create: if signedIn()
          && request.auth.uid == requestUid
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('status', '') in ['pending', 'autojoin']
          && validInvite(request.resource.data.get('inviteCode', ''), chatId);
        allow get: if signedIn() && (
          request.auth.uid == requestUid || isGroupAdmin(chatId)
        );
        allow list: if isGroupAdmin(chatId);
        allow update: if isGroupAdmin(chatId) || (
          signedIn()
          && request.auth.uid == requestUid
          && onlyChanges(['status', 'updatedAt'])
          && request.resource.data.get('status', '') == 'cancelled'
        );
        allow delete: if signedIn() && (
          request.auth.uid == requestUid || isGroupAdmin(chatId)
        );
      }
    }

    match /group_invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.get('chatId', '') is string
        && request.resource.data.get('chatId', '').size() > 0
        && request.auth.uid in groupDoc(request.resource.data.chatId).data.get('members', [])
        && groupDoc(request.resource.data.chatId).data.get('inviteCode', '') == code
        && request.resource.data.get('groupName', '') == groupDoc(request.resource.data.chatId).data.get('groupName', '')
        && request.resource.data.get('groupPhotoUrl', '') == groupDoc(request.resource.data.chatId).data.get('groupPhotoUrl', '')
        && request.resource.data.get('joinApproval', false) == groupDoc(request.resource.data.chatId).data.get('joinApproval', false)
        && request.resource.data.get('admins', []) == groupDoc(request.resource.data.chatId).data.get('admins', [])
        && request.resource.data.get('memberCount', 0) == groupDoc(request.resource.data.chatId).data.get('members', []).size();
      allow update: if signedIn()
        && request.resource.data.get('chatId', '') == resource.data.get('chatId', '')
        && request.auth.uid in groupDoc(resource.data.chatId).data.get('members', [])
        && groupDoc(resource.data.chatId).data.get('inviteCode', '') == code
        && request.resource.data.get('groupName', '') == groupDoc(resource.data.chatId).data.get('groupName', '')
        && request.resource.data.get('groupPhotoUrl', '') == groupDoc(resource.data.chatId).data.get('groupPhotoUrl', '')
        && request.resource.data.get('joinApproval', false) == groupDoc(resource.data.chatId).data.get('joinApproval', false)
        && request.resource.data.get('admins', []) == groupDoc(resource.data.chatId).data.get('admins', [])
        && request.resource.data.get('memberCount', 0) == groupDoc(resource.data.chatId).data.get('members', []).size();
      allow delete: if signedIn() && isGroupAdmin(resource.data.chatId);
    }

    match /calls/{callId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.startedBy == request.auth.uid;
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;
    }

    match /group_calls/{callId} {
      allow create: if signedIn()
        && request.resource.data.startedBy == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members;
      allow read, update: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.members;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        resource.data.toUid == request.auth.uid
        || resource.data.fromUid == request.auth.uid
      );
      allow create: if signedIn() && (
        request.resource.data.fromUid == request.auth.uid
        || request.resource.data.toUid == request.auth.uid
      );
      allow update: if signedIn() && (
        resource.data.toUid == request.auth.uid
        || (
          resource.data.fromUid == request.auth.uid
          && resource.data.get('type', '') in ['follow_request', 'friend_request']
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.get('status', '') == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'read', 'cancelledAt'])
        )
      );
      allow delete: if signedIn() && resource.data.toUid == request.auth.uid;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;
    }

    match /profile_view_stats/{targetUid}/days/{dayId} {
      allow read: if signedIn() && request.auth.uid == targetUid;
      allow create: if signedIn()
        && request.auth.uid != targetUid
        && request.resource.data.get('count', 0) == 1;
      allow update: if signedIn()
        && request.auth.uid != targetUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'day', 'updatedAt'])
        && request.resource.data.get('count', 0) == resource.data.get('count', 0) + 1;
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }
    match /support_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /live_streams/{streamId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
      match /reactions/{uid} {
        allow read: if true;
        allow create, update: if isMe(uid) && request.resource.data.uid == request.auth.uid;
        allow delete: if isMe(uid);
      }
    }
  }
}

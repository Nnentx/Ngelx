rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function chatMember() { return signedIn() && request.auth.uid in resource.data.members; }
    function formerChatMember() { return signedIn() && request.auth.uid in resource.data.get('formerMembers', []); }
    function chatViewer() { return chatMember() || formerChatMember(); }
    function incomingChatMember() { return signedIn() && request.auth.uid in request.resource.data.members; }
    function chatAdmin() {
      return signedIn() && (
        request.auth.uid in resource.data.get('admins', [])
        || request.auth.uid == resource.data.get('createdBy', '')
      );
    }
    function groupMetadataUnchanged() {
      return request.resource.data.get('groupName', '') == resource.data.get('groupName', '')
        && request.resource.data.get('groupPhotoUrl', '') == resource.data.get('groupPhotoUrl', '')
        && request.resource.data.get('backgroundUrl', '') == resource.data.get('backgroundUrl', '')
        && request.resource.data.get('backgroundOpacity', null) == resource.data.get('backgroundOpacity', null)
        && request.resource.data.get('backgroundVersion', 0) == resource.data.get('backgroundVersion', 0)
        && request.resource.data.get('backgroundChangedAt', null) == resource.data.get('backgroundChangedAt', null)
        && request.resource.data.get('admins', []) == resource.data.get('admins', [])
        && request.resource.data.get('moderators', []) == resource.data.get('moderators', [])
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && request.resource.data.get('onlyAdminsCanPost', false) == resource.data.get('onlyAdminsCanPost', false)
        && request.resource.data.get('onlyAdminsCanAddMembers', false) == resource.data.get('onlyAdminsCanAddMembers', false)
        && request.resource.data.get('onlyAdminsCanEditGroup', true) == resource.data.get('onlyAdminsCanEditGroup', true)
        && request.resource.data.get('onlyAdminsCanPin', true) == resource.data.get('onlyAdminsCanPin', true)
        && request.resource.data.get('onlyAdminsCanMentionAll', false) == resource.data.get('onlyAdminsCanMentionAll', false)
        && request.resource.data.get('newMembersSeeHistory', true) == resource.data.get('newMembersSeeHistory', true)
        && request.resource.data.get('joinApproval', false) == resource.data.get('joinApproval', false)
        && request.resource.data.get('groupDescription', '') == resource.data.get('groupDescription', '')
        && request.resource.data.get('inviteCode', '') == resource.data.get('inviteCode', '')
        && request.resource.data.get('inviteUpdatedAt', null) == resource.data.get('inviteUpdatedAt', null)
        && request.resource.data.get('groupDeleted', false) == resource.data.get('groupDeleted', false);
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    // Build531 (QA): the broad legacy group-chat update rule must not let
    // another member forge, erase or reset Build530's same-room exit markers.
    // Only the current caller may append their own UID while atomically
    // removing themself from callParticipants for this unchanged room.
    function validGroupCallExitMarkerWrite() {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      let room = resource.data.get('callRoomName', '');
      let members = resource.data.get('callParticipants', []);
      let remaining = members.removeAll([request.auth.uid]);
      let oldExitRoom = resource.data.get('callExitedRoomName', '');
      let oldExits = resource.data.get('callExitedUids', []);
      let newExits = request.resource.data.get('callExitedUids', []);
      // changed.hasOnly also guarantees the chat members, room identity,
      // other participants' metadata, and all unrelated fields are untouched.
      // List equality is cheaper and stricter than independent size,
      // containment and set-subtraction comparisons.
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && resource.data.get('callStatus', '') in ['ringing', 'active']
        && room is string && room.matches('^group_.*')
        && changes.hasOnly([
          'callParticipants', 'callExitedRoomName', 'callExitedUids',
          'callStatus', 'callEndedAt'
        ])
        && members is list && request.auth.uid in members
        && request.resource.data.get('callParticipants', []) == remaining
        && request.resource.data.get('callExitedRoomName', '') == room
        && oldExits is list
        && newExits == (oldExitRoom == room
          ? oldExits.concat([request.auth.uid]) : [request.auth.uid])
        && request.resource.data.get('callStatus', '') ==
          (remaining.size() == 0
            ? (resource.data.get('callConnectedAt', null) is timestamp
                ? 'ended' : 'missed')
            : 'active')
        && (remaining.size() == 0
          ? request.resource.data.get('callEndedAt', null) == request.time
          : request.resource.data.get('callEndedAt', null) ==
            resource.data.get('callEndedAt', null));
    }
    function groupCallExitMarkersSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['callExitedRoomName', 'callExitedUids'])
        || validGroupCallExitMarkerWrite();
    }
    // Build532: while a group call is in progress, a member cannot
    // silently rename the current LiveKit room to evade room-scoped exits.
    // Also prevent a raw participant-list write from restoring an exited UID
    // without going through an explicit, separately authorized rejoin flow.
    // Legitimate new calls after an ended/missed room may rotate room names.
    function groupCallRoomParticipantsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldRoom = resource.data.get('callRoomName', '');
      let newRoom = request.resource.data.get('callRoomName', '');
      let status = resource.data.get('callStatus', '');
      let exitedRoom = resource.data.get('callExitedRoomName', '');
      let exitedUids = resource.data.get('callExitedUids', []);
      let nextParticipants = request.resource.data.get('callParticipants', []);
      return resource.data.get('isGroup', false) != true || (
        !(changed.hasAny(['callRoomName'])
          && (status == 'ringing' || status == 'active'))
        && (
          !changed.hasAny(['callParticipants'])
          || oldRoom != newRoom
          || exitedRoom != oldRoom
          || (exitedUids is list && nextParticipants is list
            && !nextParticipants.hasAny(exitedUids))
        )
      );
    }
    // Build533 QA: one member must not terminate or revive the peers'
    // current group call using the broad legacy chat update allowance.
    // A legitimate terminal transition is either Build517's *last self*
    // departure or Build526's time-validated, never-connected missed timer.
    function validGroupUnansweredTimeout() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let participants = resource.data.get('callParticipants', []);
      let createdAt = resource.data.get('callCreatedAt', null);
      let room = resource.data.get('callRoomName', '');
      return signedIn()
        && request.auth.uid in resource.data.get('members', [])
        && resource.data.get('isGroup', false) == true
        && room is string && room.matches('^group_.*')
        && request.resource.data.get('callRoomName', '') == room
        && resource.data.get('callStatus', '') == 'ringing'
        && resource.data.get('callConnectedAt', null) == null
        && participants is list && participants.size() <= 1
        && createdAt is timestamp
        && request.time >= createdAt + duration.value(120, 's')
        && request.resource.data.get('callStatus', '') == 'missed'
        && request.resource.data.get('callAutoEnded', false) == true
        && request.resource.data.get('callAutoEndedReason', '') == 'no_participants_2m'
        && request.resource.data.get('callEndedAt', null) == request.time
        && changed.hasOnly([
          'callStatus', 'callEndedAt', 'callAutoEnded', 'callAutoEndedReason'
        ]);
    }
    // Keep the costly timeout predicate lazy: Firestore enforces a strict
    // rule-expression budget and ordinary chat writes should be cheap.
    // The preceding groupCallExitMarkersSafe() already validates an exit
    // marker mutation as this caller's own atomic last departure.
    function groupCallTerminalStateSafe() {
      let oldStatus = resource.data.get('callStatus', '');
      let nextStatus = request.resource.data.get('callStatus', '');
      let oldRoom = resource.data.get('callRoomName', '');
      let newRoom = request.resource.data.get('callRoomName', '');
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let terminalFields = ['callStatus', 'callEndedAt',
        'callAutoEnded', 'callAutoEndedReason'];
      let endMetadata = ['callEndedAt', 'callAutoEnded',
        'callAutoEndedReason'];
      return resource.data.get('isGroup', false) != true
        || !(oldRoom is string && oldRoom.matches('^group_.*'))
        || (
          (
            // Most chat edits do not touch the call lifecycle at all.
            !changed.hasAny(terminalFields)
            // Keeping the same state or acknowledging ringing->active may
            // not forge end receipts or auto-expiry markers.
            || (!changed.hasAny(endMetadata) && (
              nextStatus == oldStatus
              || (oldStatus == 'ringing' && nextStatus == 'active')
            ))
            // If markers changed, Build531's preceding guard validates
            // EXACT self departure, remaining participants, and final status.
            || (oldStatus in ['ringing','active']
              && changed.hasAny(['callExitedRoomName', 'callExitedUids'])
              && nextStatus in ['ended', 'missed'])
            // If no member left, only Build526's exact unanswered timeout
            // may close a ringing call; run this expensive check only here.
            || (oldStatus == 'ringing' && nextStatus == 'missed'
              && validGroupUnansweredTimeout())
            // A completed call can initialize a different, fresh room.
            || (oldStatus in ['ended', 'missed', 'rejected']
              && newRoom != oldRoom)
          )
          // The same room must not revive a terminal call.
          && (!(oldStatus in ['ended','missed','rejected'])
            || newRoom != oldRoom || nextStatus == oldStatus)
        );
    }
    // Build534 QA: a voluntary exit can be reversed only by that exact
    // authenticated group member's deliberate self-rejoin transaction.
    // The update touches only the participant list and their exit marker;
    // it cannot clear somebody else's exit, erase moderation, rotate rooms,
    // change call status, or reanimate an ended/missed room.
    function validGroupExplicitSelfRejoin() {
      let room = resource.data.get('callRoomName', '');
      let participants = resource.data.get('callParticipants', []);
      let oldExits = resource.data.get('callExitedUids', []);
      let kicks = resource.data.get('callKickedUids', []);
      let moderationRoom = resource.data.get('callModerationRoom', '');
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && room is string && room.matches('^group_.*')
        && resource.data.get('callStatus', '') == 'active'
        && request.auth.uid in resource.data.get('members', [])
        && resource.data.get('callStartedBy', '') in resource.data.get('members', [])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['callExitedUids', 'callParticipants'])
        && resource.data.get('callExitedRoomName', '') == room
        && oldExits is list && request.auth.uid in oldExits
        && participants is list && participants.size() > 0
        && !(request.auth.uid in participants)
        && !(kicks is list && request.auth.uid in kicks
          && (moderationRoom == '' || moderationRoom == room))
        && request.resource.data.get('callExitedUids', []) ==
          oldExits.removeAll([request.auth.uid])
        && request.resource.data.get('callParticipants', []) ==
          participants.concat([request.auth.uid]);
    }
    function founderProtected() {
      let founder = resource.data.get('createdBy', '');
      return resource.data.get('isGroup', false) != true
        || founder == ''
        || (
          request.resource.data.get('createdBy', '') == founder
          && founder in request.resource.data.get('members', [])
          && founder in request.resource.data.get('admins', [])
        );
    }
    function validFounderTransfer() {
      let oldFounder = resource.data.get('createdBy', '');
      let newFounder = request.resource.data.get('createdBy', '');
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && oldFounder != ''
        && request.auth.uid == oldFounder
        && newFounder != ''
        && newFounder != oldFounder
        && newFounder in resource.data.get('members', [])
        && newFounder in request.resource.data.get('members', [])
        && request.resource.data.get('admins', []).hasAll(resource.data.get('admins', []))
        && newFounder in request.resource.data.get('admins', [])
        && onlyChanges(['createdBy', 'admins', 'updatedAt']);
    }
    function validFormerHide() {
      return formerChatMember()
        && request.resource.data.members == resource.data.members
        && request.auth.uid in request.resource.data.get('hiddenFor', [])
        && onlyChanges(['hiddenFor']);
    }
    function validFounderClose() {
      let founder = resource.data.get('createdBy', '');
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && founder != ''
        && request.auth.uid == founder
        && resource.data.get('members', []).size() == 1
        && founder in resource.data.get('members', [])
        && request.resource.data.get('members', []).size() == 0
        && request.resource.data.get('admins', []).size() == 0
        && request.resource.data.get('createdBy', '') == founder
        && request.resource.data.get('groupDeleted', false) == true
        && onlyChanges(['members', 'admins', 'groupDeleted', 'deletedAt']);
    }
    function privateChatCreateAllowed() {
      let otherUid = request.resource.data.members[0] == request.auth.uid
        ? request.resource.data.members[1]
        : request.resource.data.members[0];
      let target = get(/databases/$(database)/documents/users/$(otherUid));
      let sender = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let permission = target.data.get(
        'messagePermission',
        target.data.get('friendsOnlyMessages', false) ? 'friends' : 'all'
      );
      return request.resource.data.members.size() == 2
        && otherUid != request.auth.uid
        && (
          permission == 'all'
          || (
            permission == 'friends'
            && (
              request.auth.uid in target.data.get('friends', [])
              || otherUid in sender.data.get('friends', [])
            )
          )
          || (
            permission == 'following'
            && request.auth.uid in target.data.get('following', [])
          )
        );
    }
    function groupDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }
    function isGroupAdmin(chatId) {
      return signedIn() && (
        request.auth.uid in groupDoc(chatId).data.get('admins', [])
        || request.auth.uid == groupDoc(chatId).data.get('createdBy', '')
      );
    }
    function validInvite(code, chatId) {
      return code is string
        && code.size() > 0
        && exists(/databases/$(database)/documents/group_invites/$(code))
        && get(/databases/$(database)/documents/group_invites/$(code)).data.get('chatId', '') == chatId
        && groupDoc(chatId).data.get('inviteCode', '') == code
        && groupDoc(chatId).data.get('groupDeleted', false) != true;
    }
    function validPublicSelfJoin() {
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && resource.data.get('discoverable', false) == true
        && resource.data.get('joinApproval', false) != true
        && !(request.auth.uid in resource.data.get('members', []))
        && resource.data.get('members', []).size() < resource.data.get('maxMembers', 60)
        && request.resource.data.get('members', []) == resource.data.get('members', []).concat([request.auth.uid])
        && request.resource.data.get('formerMembers', []) == resource.data.get('formerMembers', []).removeAll([request.auth.uid])
        && request.resource.data.get('hiddenFor', []) == resource.data.get('hiddenFor', []).removeAll([request.auth.uid])
        && onlyChanges(['members', 'formerMembers', 'hiddenFor', 'updatedAt']);
    }
    function validSelfJoin(chatId) {
      let joinReq = get(/databases/$(database)/documents/chats/$(chatId)/joinRequests/$(request.auth.uid));
      let code = joinReq.data.get('inviteCode', '');
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && resource.data.get('joinApproval', false) != true
        && request.resource.data.members.size() <= 60
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.get('formerMembers', []) == resource.data.get('formerMembers', []).removeAll([request.auth.uid])
        && onlyChanges(['members', 'formerMembers', 'hiddenFor', 'updatedAt'])
        && joinReq.data.get('uid', '') == request.auth.uid
        && joinReq.data.get('status', '') == 'autojoin'
        && validInvite(code, chatId);
    }
    function validMemberAddition() {
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && request.auth.uid in resource.data.members
        && (
          request.auth.uid in resource.data.get('admins', [])
          || request.auth.uid == resource.data.get('createdBy', '')
          || resource.data.get('onlyAdminsCanAddMembers', false) != true
        )
        && request.resource.data.members.size() > resource.data.members.size()
        && request.resource.data.members.size() <= 60
        && request.resource.data.members.hasAll(resource.data.members)
        && onlyChanges(['members', 'formerMembers', 'hiddenFor', 'updatedAt']);
    }
    function validMemberGroupEdit() {
      return signedIn()
        && resource.data.get('isGroup', false) == true
        && request.auth.uid in resource.data.members
        && resource.data.get('onlyAdminsCanEditGroup', true) != true
        && onlyChanges(['groupName', 'groupPhotoUrl', 'groupDescription', 'updatedAt']);
    }
    function relationshipUpdate() {
      return signedIn()
        && onlyChanges(['followers', 'following', 'friends'])
        && (
          request.resource.data.get('followers', []) == resource.data.get('followers', [])
          || request.auth.uid in request.resource.data.get('followers', [])
          || request.auth.uid in resource.data.get('followers', [])
        )
        && (
          request.resource.data.get('following', []) == resource.data.get('following', [])
          || request.auth.uid in request.resource.data.get('following', [])
          || request.auth.uid in resource.data.get('following', [])
        )
        && (
          request.resource.data.get('friends', []) == resource.data.get('friends', [])
          || request.auth.uid in request.resource.data.get('friends', [])
          || request.auth.uid in resource.data.get('friends', [])
        );
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // V70 device QA: redeploy catalog reads and current-group-member reaction permissions.
      match /music_catalog/{trackId} {
      // Public catalogue contains only tracks whose use rights were verified
      // by the backend/admin process. Clients can read; they cannot publish
      // arbitrary copyrighted songs into the catalogue.
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, delete: if isMe(uid);
      allow update: if isMe(uid) || relationshipUpdate();
      match /saved/{contentId} { allow read, write: if isMe(uid); }
      // AI translation/caption results are private per-user cache entries.
      // Viewers never need permission to mutate another creator's video document.
      match /content_tools/{contentId} { allow read, write: if isMe(uid); }
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || onlyChanges(['shareCount', 'viewCount', 'captionsEnabled'])
        || onlyChanges(['likeCount'])
        || onlyChanges(['commentCount'])
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /likes/{uid} {
        allow read: if true;
        allow create, update: if isMe(uid);
        allow delete: if isMe(uid) || (
          signedIn()
          && get(/databases/$(database)/documents/videos/$(videoId)).data.ownerId == request.auth.uid
        );
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid);
        allow update: if signedIn() && (
          resource.data.userId == request.auth.uid
          || onlyChanges(['likeCount'])
          || onlyChanges(['reactions'])
          || onlyChanges(['likeCount', 'reactions'])
        );
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/videos/$(videoId)).data.ownerId == request.auth.uid
        );
        match /likes/{uid} {
          allow read: if true;
          allow create, update: if isMe(uid);
          allow delete: if isMe(uid) || (
            signedIn()
            && get(/databases/$(database)/documents/videos/$(videoId)).data.ownerId == request.auth.uid
          );
        }
      }
    }

    match /chats/{chatId} {
      allow create: if incomingChatMember()
        && (
          (
            request.resource.data.get('isGroup', false) != true
            && privateChatCreateAllowed()
          )
          || (
            request.resource.data.get('isGroup', false) == true
            && request.resource.data.members.size() <= 60
            && request.auth.uid in request.resource.data.get('admins', [])
          )
        );
      allow read: if chatViewer() || (
        signedIn()
        && resource.data.get('isGroup', false) == true
        && resource.data.get('discoverable', false) == true
      );
      // Build533: bounded, complete self-exit fast path. Do not evaluate
      // every unrelated legacy group-edit rule during concurrent departures.
      // The helper permits only own UID removal + scoped marker + status,
      // checks immutable room/members, and validates last-call timestamp.
      allow update: if validGroupExplicitSelfRejoin() || (
        chatMember()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['callExitedRoomName', 'callExitedUids'])
        && validGroupCallExitMarkerWrite()
      ) || (groupCallExitMarkersSafe()
        && groupCallRoomParticipantsSafe()
        && groupCallTerminalStateSafe() && (
        chatMember() && (
          (
            resource.data.get('isGroup', false) != true
            && request.resource.data.members == resource.data.members
          )
          || (chatAdmin() && request.resource.data.members.size() <= 60 && founderProtected())
          || validFounderTransfer()
          || validMemberAddition()
          || validMemberGroupEdit()
          || (
            groupMetadataUnchanged()
            && (
              request.resource.data.members == resource.data.members
              || request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            )
          )
        )
      )) || validSelfJoin(chatId) || validPublicSelfJoin() || validFormerHide() || validFounderClose();
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          || (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('formerMembers', [])
            && get(/databases/$(database)/documents/chats/$(chatId)).data.get('removedAt_' + request.auth.uid, null) != null
            && resource.data.get('createdAt', get(/databases/$(database)/documents/chats/$(chatId)).data.get('removedAt_' + request.auth.uid, null)) <= get(/databases/$(database)/documents/chats/$(chatId)).data.get('removedAt_' + request.auth.uid, null)
          )
        );
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.get('type', 'text') != 'poll'
          && (
            (
              request.resource.data.senderId == request.auth.uid
              && (
                get(/databases/$(database)/documents/chats/$(chatId)).data.get('onlyAdminsCanPost', false) != true
                || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('admins', [])
                || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.get('createdBy', '')
                || (
                  request.resource.data.get('type', '') == 'system'
                  && request.resource.data.get('actorUid', '') == request.auth.uid
                  && request.resource.data.get('systemAction', '') in [
                    'member_added',
                    'member_joined',
                    'member_left',
                    'member_removed',
                    'nickname_changed',
                    'background_changed',
                    'founder_transferred',
                    'admin_changed',
                    'call_join',
                    'call_leave',
                    'call_end'
                  ]
                )
              )
            )
            || (
              request.resource.data.senderId == 'system'
              && (
                request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('admins', [])
                || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.get('createdBy', '')
              )
            )
          );
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && (
            (
              resource.data.senderId == request.auth.uid
              && onlyChanges(['text', 'editedAt'])
            )
            || (
              resource.data.senderId == request.auth.uid
              && onlyChanges(['callStatus', 'callAnsweredAt', 'callConnectedAt', 'callEndedAt', 'durationSeconds'])
            )
            || onlyChanges(['reactions'])
            || (
              onlyChanges(['deliveredTo', 'seenBy'])
              && request.resource.data.get('deliveredTo', []).hasAll(resource.data.get('deliveredTo', []))
              && request.resource.data.get('seenBy', []).hasAll(resource.data.get('seenBy', []))
              && request.resource.data.get('deliveredTo', []).removeAll(resource.data.get('deliveredTo', [])).hasOnly([request.auth.uid])
              && request.resource.data.get('seenBy', []).removeAll(resource.data.get('seenBy', [])).hasOnly([request.auth.uid])
            )
            || (
              get(/databases/$(database)/documents/chats/$(chatId)).data.get('isGroup', false) != true
              && onlyChanges(['pinned', 'pinnedAt', 'pinnedBy'])
            )
            || (
              (
                request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('admins', [])
                || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.get('createdBy', '')
                || get(/databases/$(database)/documents/chats/$(chatId)).data.get('onlyAdminsCanPin', true) != true
              )
              && onlyChanges(['pinned', 'pinnedAt', 'pinnedBy'])
            )
            || (
              (
                resource.data.senderId == request.auth.uid
                || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('admins', [])
                || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.get('createdBy', '')
              )
              && request.resource.data.get('deletedForEveryone', false) == true
              && onlyChanges([
                'deletedForEveryone', 'deletedAt', 'deletedBy',
                'text', 'mediaUrl', 'videoUrl', 'audioUrl', 'fileUrl', 'fileName', 'linkUrl',
                'reactions', 'pinned', 'pinnedAt', 'pinnedBy'
              ])
            )
          );
        allow delete: if signedIn() && (
          resource.data.senderId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('admins', [])
          || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.get('createdBy', '')
        );
      }

      match /joinRequests/{requestUid} {
        allow create: if (
          signedIn()
          && request.auth.uid == requestUid
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('status', '') in ['pending', 'autojoin']
          && validInvite(request.resource.data.get('inviteCode', ''), chatId)
        ) || (
          signedIn()
          && request.auth.uid in groupDoc(chatId).data.get('members', [])
          && request.resource.data.get('type', '') == 'member_add'
          && request.resource.data.get('requestedBy', '') == request.auth.uid
          && request.resource.data.get('targetUid', '') is string
          && request.resource.data.get('targetUid', '').size() > 0
          && !(request.resource.data.get('targetUid', '') in groupDoc(chatId).data.get('members', []))
          && request.resource.data.get('status', '') == 'pending'
        );
        allow get: if signedIn() && (
          request.auth.uid == requestUid
          || resource.data.get('requestedBy', '') == request.auth.uid
          || isGroupAdmin(chatId)
        );
        allow list: if isGroupAdmin(chatId);
        allow update: if isGroupAdmin(chatId) || (
          signedIn()
          && (request.auth.uid == requestUid || resource.data.get('requestedBy', '') == request.auth.uid)
          && onlyChanges(['status', 'updatedAt'])
          && request.resource.data.get('status', '') == 'cancelled'
        );
        allow delete: if signedIn() && (
          request.auth.uid == requestUid
          || resource.data.get('requestedBy', '') == request.auth.uid
          || isGroupAdmin(chatId)
        );
      }
    }

    match /group_archives/{uid}/items/{chatId} {
      allow read: if isMe(uid);
      allow create, update: if signedIn()
        && request.resource.data.get('chatId', '') == chatId
        && request.resource.data.get('targetUid', '') == uid
        && (
          request.auth.uid == uid
          || isGroupAdmin(chatId)
        );
      allow delete: if isMe(uid) || isGroupAdmin(chatId);
    }

    match /group_invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.get('chatId', '') is string
        && request.resource.data.get('chatId', '').size() > 0
        && request.auth.uid in groupDoc(request.resource.data.chatId).data.get('members', [])
        && groupDoc(request.resource.data.chatId).data.get('inviteCode', '') == code
        && request.resource.data.get('groupName', '') == groupDoc(request.resource.data.chatId).data.get('groupName', '')
        && request.resource.data.get('groupPhotoUrl', '') == groupDoc(request.resource.data.chatId).data.get('groupPhotoUrl', '')
        && request.resource.data.get('joinApproval', false) == groupDoc(request.resource.data.chatId).data.get('joinApproval', false)
        && request.resource.data.get('admins', []) == groupDoc(request.resource.data.chatId).data.get('admins', [])
        && request.resource.data.get('memberCount', 0) == groupDoc(request.resource.data.chatId).data.get('members', []).size();
      allow update: if signedIn()
        && request.resource.data.get('chatId', '') == resource.data.get('chatId', '')
        && request.auth.uid in groupDoc(resource.data.chatId).data.get('members', [])
        && groupDoc(resource.data.chatId).data.get('inviteCode', '') == code
        && request.resource.data.get('groupName', '') == groupDoc(resource.data.chatId).data.get('groupName', '')
        && request.resource.data.get('groupPhotoUrl', '') == groupDoc(resource.data.chatId).data.get('groupPhotoUrl', '')
        && request.resource.data.get('joinApproval', false) == groupDoc(resource.data.chatId).data.get('joinApproval', false)
        && request.resource.data.get('admins', []) == groupDoc(resource.data.chatId).data.get('admins', [])
        && request.resource.data.get('memberCount', 0) == groupDoc(resource.data.chatId).data.get('members', []).size();
      allow delete: if signedIn() && isGroupAdmin(resource.data.chatId);
    }

    match /calls/{callId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.startedBy == request.auth.uid;
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;
    }

    match /group_calls/{callId} {
      allow create: if signedIn()
        && request.resource.data.startedBy == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members;
      allow read, update: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.members;
      allow delete: if false;
    }

    // Build 360: Takip ve arkadaşlık istekleri bildirimlerden bağımsız source-of-truth belgelerinde tutulur.
    function validSocialRequestCreate(fromUid, toUid, kind) {
      return signedIn()
        && request.auth.uid == fromUid
        && fromUid != toUid
        && request.resource.data.get('fromUid', '') == fromUid
        && request.resource.data.get('toUid', '') == toUid
        && request.resource.data.get('type', '') == kind
        && request.resource.data.get('status', '') == 'pending';
    }

    function validSocialRequestUpdate(fromUid, toUid, kind) {
      return signedIn()
        && request.resource.data.get('fromUid', '') == fromUid
        && request.resource.data.get('toUid', '') == toUid
        && request.resource.data.get('type', '') == kind
        && request.resource.data.get('fromUid', '') == resource.data.get('fromUid', '')
        && request.resource.data.get('toUid', '') == resource.data.get('toUid', '')
        && request.resource.data.get('type', '') == resource.data.get('type', '')
        && (
          (
            request.auth.uid == fromUid
            && request.resource.data.get('status', '') in ['pending', 'cancelled']
          )
          || (
            request.auth.uid == toUid
            && resource.data.get('status', '') == 'pending'
            && request.resource.data.get('status', '') in ['accepted', 'rejected']
          )
        );
    }

    match /follow_requests/{fromUid}/outgoing/{toUid} {
      allow read: if signedIn() && (request.auth.uid == fromUid || request.auth.uid == toUid);
      allow create: if validSocialRequestCreate(fromUid, toUid, 'follow_request');
      allow update: if validSocialRequestUpdate(fromUid, toUid, 'follow_request');
      allow delete: if false;
    }

    match /friend_requests/{fromUid}/outgoing/{toUid} {
      allow read: if signedIn() && (request.auth.uid == fromUid || request.auth.uid == toUid);
      allow create: if validSocialRequestCreate(fromUid, toUid, 'friend_request');
      allow update: if validSocialRequestUpdate(fromUid, toUid, 'friend_request');
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        resource.data.toUid == request.auth.uid
        || resource.data.fromUid == request.auth.uid
      );
      allow create: if signedIn() && (
        request.resource.data.fromUid == request.auth.uid
        || request.resource.data.toUid == request.auth.uid
      );
      allow update: if signedIn() && (
        resource.data.toUid == request.auth.uid
        || (
          resource.data.fromUid == request.auth.uid
          && resource.data.get('type', '') in ['follow_request', 'friend_request']
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.get('status', '') == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'read', 'cancelledAt'])
        )
      );
      allow delete: if signedIn() && resource.data.toUid == request.auth.uid;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;
    }

    match /profile_view_stats/{targetUid}/days/{dayId} {
      allow read: if signedIn() && request.auth.uid == targetUid;
      allow create: if signedIn()
        && request.auth.uid != targetUid
        && request.resource.data.get('count', 0) == 1;
      allow update: if signedIn()
        && request.auth.uid != targetUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'day', 'updatedAt'])
        && request.resource.data.get('count', 0) == resource.data.get('count', 0) + 1;
      allow delete: if false;
    }

    match /account_deletion_requests/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'scheduled'
        && request.resource.data.get('executeAfter', null) is timestamp;
      allow update: if isMe(uid)
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('status', '') in ['scheduled', 'cancelled'];
      allow delete: if isMe(uid);
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }
    match /support_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /audio_room_owner_locks/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.get('roomId', '') is string
        && request.resource.data.get('roomId', '').size() > 0;
      allow update: if isMe(uid)
        && request.resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.get('roomId', '') is string
        && request.resource.data.get('roomId', '').size() > 0;
      allow delete: if isMe(uid);
    }

    match /audio_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.get('speakerIds', [])
        && request.resource.data.get('speakerIds', []).size() <= 12
        && request.resource.data.get('moderatorIds', []).size() <= 3;
      allow update: if signedIn()
        && request.resource.data.get('speakerIds', []).size() <= 12
        && request.resource.data.get('moderatorIds', []).size() <= 3
        && (
          resource.data.ownerId == request.auth.uid
          || (
            request.auth.uid in resource.data.get('moderatorIds', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'speakerIds', 'speakerCount', 'chatMutedUserIds', 'updatedAt',
              'musicUrl', 'musicTitle', 'musicPlaying', 'musicPositionMs',
              'musicStartedAt', 'musicDurationMs', 'musicAddedBy', 'musicUpdatedAt'
            ])
          )
        );
      allow delete: if false;
      match /speaker_requests/{uid} {
        allow read: if signedIn() && (
          isMe(uid)
          || get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('ownerId', '') == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('moderatorIds', [])
        );
        allow create: if isMe(uid)
          && request.resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'pending'
          && !(request.auth.uid in get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('bannedUserIds', []));
        allow update: if signedIn() && (
          (
            isMe(uid)
            && request.resource.data.get('userId', '') == request.auth.uid
            && request.resource.data.get('status', '') in ['pending', 'cancelled']
          )
          || get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('ownerId', '') == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('moderatorIds', [])
        );
        allow delete: if signedIn() && (
          isMe(uid)
          || get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('ownerId', '') == request.auth.uid
        );
      }
      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if isMe(uid)
          && request.resource.data.get('userId', '') == request.auth.uid
          && !(request.auth.uid in get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('bannedUserIds', []))
          && (
            request.resource.data.get('role', 'listener') == 'listener'
            || get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('ownerId', '') == request.auth.uid
          );
        allow update: if signedIn() && (
          (
            isMe(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'lastSeenAt', 'leftAt', 'joinedAt', 'displayName', 'photoUrl'])
          )
          || get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('ownerId', '') == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('moderatorIds', [])
        );
        allow delete: if false;
      }
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() <= 600
          && get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('active', false) == true
          && !(request.auth.uid in get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('chatMutedUserIds', []))
          && !(request.auth.uid in get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('bannedUserIds', []));
        allow update: if signedIn()
          && (
            (
              resource.data.get('userId', '') == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
              && request.resource.data.get('text', '') is string
              && request.resource.data.get('text', '').size() <= 600
            )
            || (
              (
                get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('ownerId', '') == request.auth.uid
                || request.auth.uid in get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('moderatorIds', [])
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'updatedAt'])
            )
          );
        allow delete: if signedIn() && (
          resource.data.get('userId', '') == request.auth.uid
          || get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('ownerId', '') == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('moderatorIds', [])
        );
      }
      match /reactions/{reactionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.get('emoji', '') is string;
        allow update: if false;
        allow delete: if signedIn() && (
          resource.data.get('userId', '') == request.auth.uid
          || get(/databases/$(database)/documents/audio_rooms/$(roomId)).data.get('ownerId', '') == request.auth.uid
        );
      }
    }
    match /live_streams/{streamId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid);
      }
      match /reactions/{uid} {
        allow read: if true;
        allow create, update: if isMe(uid) && request.resource.data.uid == request.auth.uid;
        allow delete: if isMe(uid);
      }
    }
  }
}

  Future<void> _guestSync448(bool accepted)async{
    _guestWanted448=accepted;
    if(_guestConnecting448||!mounted||kapatildi||yayinBitti||accepted==_guestActive448)return;
    _guestConnecting448=true;
    try{
      // Stop publishing immediately on rejection, before any token/network request.
      if(!accepted){await widget.oda.localParticipant?.setCameraEnabled(false);await widget.oda.localParticipant?.setMicrophoneEnabled(false);if(mounted)setState(()=>_guestActive448=false);}
      final me=FirebaseAuth.instance.currentUser?.uid;if(me==null)return;

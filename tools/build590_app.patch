+    return Semantics(label: empty ? 'Boş mikrofon yeri' : '$name, $role, ${micOpen ? 'mikrofon açık' : 'mikrofon kapalı'}',
+      child: InkWell(onTap: onTap, borderRadius: BorderRadius.circular(28), child: Column(
+        mainAxisAlignment: MainAxisAlignment.center, children: [
+          SizedBox(width: diameter, height: diameter, child: empty
+            ? DecoratedBox(decoration: const BoxDecoration(color: Color(0xFF303030), shape: BoxShape.circle),
+                child: Icon(Icons.add_rounded, size: diameter * .43, color: Colors.white38))
+            : Stack(clipBehavior: Clip.none, children: [
+                Positioned.fill(child: AnimatedContainer(duration: const Duration(milliseconds: 180),
+                  padding: EdgeInsets.all(host || speaking ? 4 : 0),
+                  decoration: BoxDecoration(shape: BoxShape.circle, border: Border.all(
+                    color: speaking ? const Color(0xFF35E9B0) : host ? Colors.white24 : Colors.transparent,
+                    width: speaking ? 2.5 : 2)),
+                  child: CircleAvatar(backgroundImage: photo, backgroundColor: const Color(0xFF333333),
+                    child: photo == null ? Icon(Icons.person, color: Colors.white60, size: diameter * .42) : null))),
+                if (!micOpen) Positioned(right: 0, bottom: 0, child: CircleAvatar(radius: math.min(10.0, diameter * .15),
+                  backgroundColor: Colors.black, child: Icon(Icons.mic_off_rounded, color: Colors.white, size: math.min(12.0, diameter * .2)))),
+              ])),
+          ...[
+            const SizedBox(height: 4),
+            Text(empty ? ' ' : name, maxLines: 1, overflow: TextOverflow.ellipsis,
+              style: const TextStyle(color: Colors.white, fontSize: 12, fontWeight: FontWeight.w500)),
+            const SizedBox(height: 2),
+            Text(empty || role.isEmpty ? ' ' : role, maxLines: 1, overflow: TextOverflow.ellipsis,
+              style: const TextStyle(color: Colors.white70, fontSize: 10)),
+          ],
+        ])));
+  });
+}

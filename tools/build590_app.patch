+        if (!host) SizedBox(height: 34, child: TextButton(
+          style: TextButton.styleFrom(backgroundColor: _pink590, foregroundColor: Colors.white,
+            padding: const EdgeInsets.symmetric(horizontal: 10), minimumSize: const Size(0, 34)),

+/// The full audio-room composition used by the live page and phone visual tests.
+class Ngelx590AudioStage extends StatelessWidget {
+  final Widget header, controls, chat;
+  final IndexedWidgetBuilder seatBuilder;
+  final int seatCount;
+  final Widget? notice;
+  const Ngelx590AudioStage({super.key, required this.header, required this.controls,
+    required this.chat, required this.seatBuilder, this.seatCount = 9, this.notice});
+  @override
+  Widget build(BuildContext context) => ColoredBox(color: Colors.black, child: SafeArea(
+    child: Column(children: [
+      Padding(padding: const EdgeInsets.fromLTRB(12, 4, 8, 0), child: header),
+      Padding(padding: const EdgeInsets.fromLTRB(12, 7, 12, 0), child: controls),
+      if (notice != null) notice!,
+      Expanded(child: LayoutBuilder(builder: (context, box) {
+        final stageHeight = math.min(box.maxWidth * 1.01, box.maxHeight * .64);
+        return Column(children: [
+          if (MediaQuery.viewInsetsOf(context).bottom == 0) SizedBox(height: stageHeight, child: Padding(
+            padding: const EdgeInsets.symmetric(horizontal: 14),
+            child: GridView.builder(key: const ValueKey('audio590-grid'),
+              padding: const EdgeInsets.only(top: 38, bottom: 4), primary: false,
+              physics: seatCount > 9 ? const ClampingScrollPhysics() : const NeverScrollableScrollPhysics(),
+              gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(crossAxisCount: 3,
+                mainAxisExtent: math.max(1.0, (stageHeight - 42) / 3), crossAxisSpacing: 14),
+              itemCount: seatCount, itemBuilder: seatBuilder),
+          )),
+          Expanded(child: chat),
+        ]);
+      })),
+    ]),
+  ));
+}

@@ -0,0 +1,106 @@
+import 'package:flutter/material.dart';
+
+/// Shared actual room seat, independently renderable without a live connection.
+class Ngelx589AudioSeat extends StatelessWidget {
+  final String name, role;
+  final ImageProvider? photo;
+  final bool speaking, micOpen, host, empty;
+  final VoidCallback? onTap;
+  const Ngelx589AudioSeat({
+    super.key,
+    this.name = '',
+    this.role = '',
+    this.photo,
+    this.speaking = false,
+    this.micOpen = false,
+    this.host = false,
+    this.empty = false,
+    this.onTap,
+  });
+  @override
+  Widget build(BuildContext context) {
+    if (empty) {
+      return InkWell(
+        onTap: onTap,
+        borderRadius: BorderRadius.circular(70),
+        child: Center(
+          child: Semantics(
+            label: 'Boş mikrofon yeri',
+            child: AspectRatio(
+              aspectRatio: 1,
+              child: FractionallySizedBox(
+                widthFactor: .8,
+                heightFactor: .8,
+                child: Container(
+                  decoration: const BoxDecoration(
+                    color: Color(0xFF303030),
+                    shape: BoxShape.circle,
+                  ),
+                  child: const Icon(Icons.add_rounded, color: Colors.white54, size: 42),
+                ),
+              ),
+            ),
+          ),
+        ),
+      );
+    }
+    return Semantics(
+      label: '$name, $role, ${micOpen ? 'mikrofon açık' : 'mikrofon kapalı'}${speaking ? ', konuşuyor' : ''}',
+      child: InkWell(
+        onTap: onTap,
+        borderRadius: BorderRadius.circular(24),
+        child: Column(
+          mainAxisAlignment: MainAxisAlignment.center,
+          children: [
+            Flexible(
+              child: AspectRatio(
+                aspectRatio: 1,
+                child: Padding(
+                  padding: const EdgeInsets.all(4),
+                  child: Stack(
+                    children: [
+                      Positioned.fill(
+                        child: AnimatedContainer(
+                          duration: const Duration(milliseconds: 180),
+                          padding: const EdgeInsets.all(5),
+                          decoration: BoxDecoration(
+                            shape: BoxShape.circle,
+                            border: Border.all(
+                              color: speaking ? const Color(0xFF35E9B0) : host ? Colors.white24 : Colors.transparent,
+                              width: speaking ? 3 : 2,
+                            ),
+                            boxShadow: speaking ? const [BoxShadow(color: Color(0x4435E9B0), blurRadius: 14)] : null,
+                          ),
+                          child: CircleAvatar(
+                            backgroundImage: photo,
+                            backgroundColor: const Color(0xFF303030),
+                            child: photo == null ? const Icon(Icons.person, color: Colors.white60) : null,
+                          ),
+                        ),
+                      ),
+                      if (!micOpen)
+                        const Positioned(
+                          right: 5,
+                          bottom: 4,
+                          child: CircleAvatar(
+                            radius: 12,
+                            backgroundColor: Colors.black,
+                            child: Icon(Icons.mic_off_rounded, color: Colors.white, size: 15),
+                          ),
+                        ),
+                    ],
+                  ),
+                ),
+              ),
+            ),
+            Text(name, maxLines: 1, overflow: TextOverflow.ellipsis,
+              style: const TextStyle(color: Colors.white, fontSize: 12, fontWeight: FontWeight.w600)),
+            const SizedBox(height: 3),
+            Text(role, maxLines: 1, overflow: TextOverflow.ellipsis,
+              style: const TextStyle(color: Colors.white70, fontSize: 10)),
+          ],
+        ),
+      ),
+    );
+  }
+}

+/// Async native audio loading must not outlive mute or widget disposal.
+Future<void> ngelx589PlayGiftSound({
+  required bool Function() allowed,
+  required Future<void> Function() load,
+  required Future<void> Function() volume,
+  required Future<void> Function() play,
+}) async {
+  if (!allowed()) return;
+  await load();
+  if (!allowed()) return;
+  await volume();
+  if (!allowed()) return;
+  await play();
+}

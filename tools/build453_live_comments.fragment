  Widget _yorumPaneli(){
    final keyboard=MediaQuery.of(context).viewInsets.bottom>0;
    return StreamBuilder<QuerySnapshot<Map<String,dynamic>>>(stream:_comments448,builder:(_,snap){
      final docs=(snap.data?.docs??[]).take(keyboard?1:3).toList().reversed.toList();
      return ConstrainedBox(constraints:BoxConstraints(maxWidth:MediaQuery.sizeOf(context).width*.72),child:Column(mainAxisSize:MainAxisSize.min,crossAxisAlignment:CrossAxisAlignment.start,children:docs.map((d){
        final y=d.data(),uid=(y['uid']??y['userId']??'').toString();
        final profile=uid.isEmpty?null:_commentProfiles453.putIfAbsent(uid,()=>FirebaseFirestore.instance.collection('users').doc(uid).get());
        return FutureBuilder<DocumentSnapshot<Map<String,dynamic>>>(future:profile,builder:(_,p){
          final person=p.data?.data()??<String,dynamic>{};
          final photo=(person['photoUrl']??'').toString();
          final name=(person['displayName']??y['username']??'İzleyici').toString();
          final message=y['kind']=='join'?'Yayına katıldı 👋':(y['text']??'').toString();
          return GestureDetector(onLongPress:widget.yayinSahibi?()=>_yorumYonet(d.id,y):null,child:Container(
            margin:const EdgeInsets.only(top:5),padding:const EdgeInsets.symmetric(horizontal:9,vertical:7),
            decoration:BoxDecoration(color:const Color(0xA6222222),borderRadius:BorderRadius.circular(18)),
            child:Row(mainAxisSize:MainAxisSize.min,children:[CircleAvatar(radius:17,backgroundImage:photo.isEmpty?null:NgelXAgImageProvider(photo),child:photo.isEmpty?const Icon(Icons.person,size:18):null),const SizedBox(width:8),Flexible(child:Column(mainAxisSize:MainAxisSize.min,crossAxisAlignment:CrossAxisAlignment.start,children:[Text(name,maxLines:1,overflow:TextOverflow.ellipsis,style:const TextStyle(color:Colors.white,fontSize:12.5,fontWeight:FontWeight.w800)),Text(message,maxLines:keyboard?1:2,overflow:TextOverflow.ellipsis,style:const TextStyle(color:Colors.white,fontSize:13))]))]),
          ));
        });
      }).toList()));
    });
  }

  Widget _yorumGirisAlani()=>Ngelx453LiveComposer(key:_composerKey453,controller:yorum,focus:_commentFocus453,stream:_liveStream448,host:widget.yayinSahibi,uid:FirebaseAuth.instance.currentUser?.uid??'',send:_yorumGonder);

